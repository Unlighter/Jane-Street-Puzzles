def greedy_seq(steps=40):
    visited, pos, seq = {0}, 0, [0]
    for n in range(1, steps+1):
        down, up = pos - n, pos + n
        if down > 0 and down not in visited:
            move = down
        elif up not in visited:
            move = up
        else:
            break
        visited.add(move); seq.append(move); pos = move
    return seq

seq = greedy_seq(40)
fig, axes = plt.subplots(2, 1, figsize=(15, 7), gridspec_kw={'height_ratios':[3,1]})

ax = axes[0]
